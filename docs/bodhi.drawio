        <mxCell id="K9I6vbQ4g4FevOCkwQSP-4" value="«interface»&lt;br&gt;&lt;b&gt;generate_graph&lt;/b&gt;" style="html=1;whiteSpace=wrap;" vertex="1" parent="1">
