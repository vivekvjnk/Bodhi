        <mxCell id="K9I6vbQ4g4FevOCkwQSP-11" value="&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Text extraction from source document, Text unit preparation(storing text units and extracted text)&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Priming summary generation, summarization of outlier text units&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Langgraph graph object creation&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Map-Reduce operations&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Thread orchestration&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="678" y="670" width="570" height="110" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-14" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="670" y="770" width="480" height="240" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-9" value="«interface»&lt;br&gt;&lt;b&gt;extract_knowledge_graph_parallel&lt;/b&gt;" style="html=1;whiteSpace=wrap;" vertex="1" parent="K9I6vbQ4g4FevOCkwQSP-14">
          <mxGeometry width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-10" value="&lt;div&gt;Performs the map-reduce process to extract a knowledge graph from a source document in parallel.&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&amp;nbsp;Setup: Initializes logging, configuration, and necessary paths.&lt;/li&gt;&lt;li&gt;&amp;nbsp;Pre-computation: Checks if text units (chunks) are already processed. If not, it extracts them from the source document and saves them.&lt;/li&gt;&lt;li&gt;Map Phase: Splits the text chunks among multiple threads. Each thread invokes a LangGraph graph to process its assigned chunks independently.&lt;/li&gt;&lt;li&gt;Reduce Phase: After all threads complete extraction, system combines the intermediate results generated by each thread into a final, consolidated output.&lt;/li&gt;&lt;/ol&gt;NB: kg_extraction_subgraph runnable is created only once. This object is shared between all the threads.&amp;nbsp;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="K9I6vbQ4g4FevOCkwQSP-14">
          <mxGeometry y="50" width="480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-18" value="Use" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;curved=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.48;entryY=0.063;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="K9I6vbQ4g4FevOCkwQSP-10" target="K9I6vbQ4g4FevOCkwQSP-20">
          <mxGeometry width="160" relative="1" as="geometry">
            <mxPoint x="760" y="1040" as="sourcePoint" />
            <mxPoint x="790" y="1150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-19" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="670" y="1160" width="470" height="220" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-20" value="«interface»&lt;br&gt;&lt;b&gt;create_extraction_subgraph&lt;/b&gt;" style="html=1;whiteSpace=wrap;" vertex="1" parent="K9I6vbQ4g4FevOCkwQSP-19">
          <mxGeometry width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-21" value="&lt;div&gt;Returns a Langgraph runnable object&lt;/div&gt;&lt;div&gt;Implements knowledge graph extraction algorithm with persistence&lt;/div&gt;&lt;div&gt;From each text unit module extract entities. validate_entities check if any highly relevant entities are missing from the extraction, if yes, then entity extraction is repeated.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Once entity extraction is completed for a text unit, the extracted entities along with text unit is transferred to extract_relationships. This node extracts relationships between the specified entities. Here also a validation loop is implemented to identify missing relations.&lt;/div&gt;&lt;div&gt;Both validation loops are limited to 4 iterations.&amp;nbsp;&lt;/div&gt;&lt;div&gt;(NB: this is not a hard coded limit, instead LLM is instructed to stop the loop if iteration count is greater than 4. Hence the loops are completely controlled by LLM)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="K9I6vbQ4g4FevOCkwQSP-19">
          <mxGeometry y="50" width="470" height="170" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-56" value="kg_extraction_graph runnable" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="1050" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-60" value="return" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=12;exitX=0.75;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="K9I6vbQ4g4FevOCkwQSP-20">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="916" y="1064.41" as="sourcePoint" />
            <mxPoint x="850" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
