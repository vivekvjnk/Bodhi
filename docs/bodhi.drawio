        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-7" value="&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;Setup all artifact and data paths&lt;/li&gt;&lt;li&gt;Check if final Knowledge Graph exists. If yes load graph and return, instruct to go to END&lt;/li&gt;&lt;li&gt;Check if intermediate graph is present, if yes load intermediate graph and go to resolve graph&lt;/li&gt;&lt;li&gt;Else call the extract knowledge graph api, return the intermediate graph generated from the api&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="110" y="820" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-8" value="Use" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;curved=1;" edge="1" parent="1">
          <mxGeometry width="160" relative="1" as="geometry">
            <mxPoint x="510" y="794.58" as="sourcePoint" />
            <mxPoint x="670" y="794.58" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-9" value="«interface»&lt;br&gt;&lt;b&gt;extract_knowledge_graph_parallel&lt;/b&gt;" style="html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="670" y="770" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-10" value="&lt;div&gt;Performs the map-reduce process to extract a knowledge graph from a source document in parallel.&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&amp;nbsp;Setup: Initializes logging, configuration, and necessary paths.&lt;/li&gt;&lt;li&gt;&amp;nbsp;Pre-computation: Checks if text units (chunks) are already processed. If not, it extracts them from the source document and saves them.&lt;/li&gt;&lt;li&gt;Map Phase: Splits the text chunks among multiple threads. Each thread invokes a LangGraph graph to process its assigned chunks independently.&lt;/li&gt;&lt;li&gt;Reduce Phase: After all threads complete extraction, system combines the intermediate results generated by each thread into a final, consolidated output.&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="670" y="820" width="470" height="170" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-11" value="&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Text extraction from source document, Text unit preparation(storing text units and extracted text)&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Priming summary generation, summarization of outlier text units&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Langgraph graph object creation&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Map-Reduce operations&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Thread orchestration&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="920" y="710" width="570" height="110" as="geometry" />
        </mxCell>
