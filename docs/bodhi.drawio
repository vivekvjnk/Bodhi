          <mxGeometry width="160" relative="1" as="geometry">
            <mxPoint x="790" y="1380" as="sourcePoint" />
            <mxPoint x="950" y="1460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-65" value="&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Input and output of `kg_extraction_graph`&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;follows `BodhiState` schema&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="1810" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-66" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Legend&lt;/h1&gt;&lt;p&gt;Green node : Node with LLM call&lt;/p&gt;&lt;p&gt;Red node : Node with no&amp;nbsp; LLM calls&lt;/p&gt;&lt;p&gt;Extraction agent : Extract entities/relationships from given text chunk&lt;/p&gt;&lt;p&gt;Validation agent : Validate if extracted entities/relationships are representative of the given text chunk.&lt;/p&gt;&lt;p&gt;KG extraction orchestrator : Process and save intermediate data(subgraph of each chunk), Collect and pass next chunk to be processed, Check if all chunks are processed; if yes end process, otherwise continue with next chunk&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1900" width="310" height="260" as="geometry" />
        </mxCell>
