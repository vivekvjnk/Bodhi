        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-7" value="&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;Setup all artifact and data paths&lt;/li&gt;&lt;li&gt;Check if final Knowledge Graph exists. If yes load graph and return, instruct to go to END&lt;/li&gt;&lt;li&gt;Check if intermediate graph is present, if yes load intermediate graph and go to resolve graph&lt;/li&gt;&lt;li&gt;Else call the extract knowledge graph api, return the intermediate graph generated from the api&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="110" y="820" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="K9I6vbQ4g4FevOCkwQSP-8" value="Use" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;curved=1;" edge="1" parent="1">
