 {'Convolutional neural networks (CNNs)': {'type': ['GENERIC'], 'description': ['Deep learning models used for feature extraction and classification in object detection tasks.'], 'source_chunk_index': [0]}, 'AlexNet': {'type': ['method', 'method', 'method', 'method'], 'description': ['A convolutional neural network architecture used as a feature extractor within the R-CNN framework, explored for car detection accuracy.', 'A convolutional neural network architecture used as a feature extractor within the Faster R-CNN framework.', 'A convolutional neural network architecture used as a feature extractor within the Faster R-CNN framework; used to evaluate the impact of shallower networks on accuracy.', 'A CNN architecture used as a feature extractor within the R-CNN framework. The paper uses AlexNet to evaluate the impact of shallower convolutional layers on detection accuracy, comparing it with VGG16.'], 'source_chunk_index': [0, 1, 2, 2]}, 'VGG16': {'type': ['method', 'method', 'method'], 'description': ['A convolutional neural network architecture used as a feature extractor within the R-CNN framework, and its impact on detection accuracy is examined.', 'A convolutional neural network architecture used as a feature extractor within the Faster R-CNN framework, known for its sixteen convolutional layers.', 'A convolutional neural network architecture used as a feature extractor within the Faster R-CNN framework; the paper examines the impact of different convolutional layers (e.g., conv4_3, conv5_3) on detection accuracy.'], 'source_chunk_index': [0, 1, 2]}, 'Region Proposal Network (RPN)': {'type': ['method', 'method', 'generic'], 'description': ['A network within Faster R-CNN that proposes potential object bounding boxes, improving the efficiency of object detection.', 'A network within Faster R-CNN that proposes potential object bounding boxes, used to identify potential object locations.', 'A network within Faster R-CNN that proposes potential object bounding boxes.'], 'source_chunk_index': [0, 1, 2]}, 'ImageNet': {'type': ['dataset', 'dataset'], 'description': ['A large-scale image dataset used for pre-training CNNs.', 'A large-scale image dataset used for pre-training CNNs, such as AlexNet and VGG16.'], 'source_chunk_index': [0, 1]}, 'R-CNN': {'type': ['method'], 'description': ['A method that uses selective search for object region proposal.'], 'source_chunk_index': [0]}, 'Deformable parts models (DPM)': {'type': ['method'], 'description': ['A method for image object detection that was state-of-the-art before the emergence of deep convolutional neural nets.'], 'source_chunk_index': [0]}, 'SPPNet': {'type': ['method'], 'description': ['A method that inspired Faster R-CNN, using shared convolutional feature maps for fast object detection.'], 'source_chunk_index': [0]}, 'OverFeat': {'type': ['method'], 'description': ['A method that predicts a single box for localization.'], 'source_chunk_index': [0]}, 'Multibox': {'type': ['method'], 'description': ['A method that predicts multiple boxes in a class-agnostic way.'], 'source_chunk_index': [0]}, 'PASCAL': {'type': ['dataset'], 'description': ['A dataset used for building supervised 2D datasets, alongside ImageNet, where mechanical turk workers annotate user-generated images and videos.'], 'source_chunk_index': [0]}, 'SDP+CRC': {'type': ['method'], 'description': ["A high-accuracy method for identifying objects in the KITTI dataset, combining scale dependent pooling (SDP) with cascaded region classifiers (CRC). It selects either a high-resolution or a heavily downsampled CNN layer based on the region proposal's resolution."], 'source_chunk_index': [0]}, 'Mono 3D': {'type': ['method'], 'description': ['An approach that uses 2D images to identify the pose of objects, with the goal of detecting objects as 3D bounding boxes. It is built around a version of R-CNN.'], 'source_chunk_index': [0]}, 'Intersection over Union (IoU)': {'type': ['generic', 'generic'], 'description': ['A metric used to evaluate the accuracy of object detection by measuring the overlap between the predicted bounding box and the ground truth bounding box.', 'A metric used to evaluate the overlap between the predicted bounding box and the ground truth bounding box. It is used to assess the accuracy of object detection.'], 'source_chunk_index': [0, 2]}, 'Detection Accuracy (easy, medium, hard categories)': {'type': ['generic'], 'description': ['Evaluation of object detection performance categorized by difficulty levels, likely based on factors like object size, occlusion, and distance from the camera, as defined by the KITTI dataset.'], 'source_chunk_index': [0]}, 'Convolutional Layers': {'type': ['GENERIC'], 'description': ['Layers within CNN architectures (AlexNet, VGG16) that extract features from images. The paper examines the impact of different convolutional layers on detection accuracy.'], 'source_chunk_index': [1]}, 'R-CNN branch': {'type': ['GENERIC'], 'description': ['The branch of the Faster R-CNN architecture that uses fully connected layers for classification.'], 'source_chunk_index': [1]}, 'IoU': {'type': ['generic'], 'description': ['Intersection over Union, an evaluation metric used to assess the accuracy of object detection.'], 'source_chunk_index': [1]}, 'Easy, Medium, Hard Categories': {'type': ['GENERIC'], 'description': ["Categories used in the KITTI dataset's evaluation criteria to assess detection accuracy based on the difficulty of the detection task."], 'source_chunk_index': [1]}, 'ROI Pooling': {'type': ['method'], 'description': ['A technique developed by the R-CNN authors that allows input images of any size to be used with AlexNet/VGG fully connected layers.'], 'source_chunk_index': [1]}, 'Detection Accuracy': {'type': ['generic', 'task', 'task'], 'description': ['A metric used to evaluate the performance of object detection models, often categorized into easy, medium, and hard detections.', 'The ability of the model to correctly identify and locate cars in images, categorized as easy, medium, and hard detections.', "The primary evaluation metric used to assess the performance of car detection models, specifically categorized into 'easy', 'medium', and 'hard' detection difficulties."], 'source_chunk_index': [2, 2, 2]}, 'Inference Time': {'type': ['generic'], 'description': ['The time taken to perform object detection.'], 'source_chunk_index': [2]}, 'VGG16-based feature representation': {'type': ['method'], 'description': ['A configuration of Faster R-CNN that uses VGG16 as the CNN backbone for feature extraction. The paper explores the impact of different convolutional layers (conv4_3, conv5_3) within this configuration on detection accuracy.'], 'source_chunk_index': [2]}, 'R-CNN region-proposal and classification branches': {'type': ['method'], 'description': ['The components of the R-CNN framework responsible for proposing potential object bounding boxes and classifying them. The paper uses these branches with AlexNet and VGG16.'], 'source_chunk_index': [2]}, 'anchor box selection schemes': {'type': ['method'], 'description': ["Different methods for selecting anchor boxes, which are pre-defined bounding boxes used to propose object locations in Faster R-CNN. The paper tests the AlexNet-based Faster R-CNN's detection accuracy with different schemes."], 'source_chunk_index': [2]}, 'Input image resolution': {'type': ['generic'], 'description': ['The size of the input images, which significantly impacts detection accuracy. The paper explores different input resolutions (e.g., 2000x604, 5000x1510) for AlexNet and VGG16 configurations.'], 'source_chunk_index': [2]}, 'AlexNet conv5': {'type': ['method'], 'description': ['The 5th convolutional layer of the AlexNet CNN architecture, used as a feature extractor within the R-CNN framework for car detection. Activations from this layer are used as input to the R-CNN region-proposal and classification branches.'], 'source_chunk_index': [2]}, 'Object detection': {'description': ['The process of identifying and localizing objects within images.', 'The process of identifying and localizing objects (cars) in images, a key focus of the paper within the context of ADAS.'], 'type': ['task', 'GENERIC'], 'source_chunk_index': [0, 1]}, 'Faster R-CNN': {'description': ['A deep learning object detection method, an evolution of R-CNN and Fast R-CNN, utilizing a Region Proposal Network (RPN) to suggest object locations.', 'A deep learning object detection method that utilizes a region proposal network (RPN) to suggest object locations, used for car detection in ADAS applications.', 'A deep learning object detection method used for car detection, employing a Region Proposal Network (RPN).', 'An evolution of the R-CNN method that reuses shared convolution features for region proposals.'], 'type': ['method'], 'source_chunk_index': [0, 1, 2]}, 'Car detection': {'description': ['The task of identifying and locating cars within images, a key application in ADAS.'], 'type': ['task', 'Task'], 'source_chunk_index': [0, 2]}, 'KITTI dataset': {'description': ['A dataset for autonomous driving research, used to evaluate the performance of object detection methods like Faster R-CNN.', 'A dataset for autonomous driving research, used to evaluate the performance of the proposed methods.'], 'type': ['dataset', 'Dataset'], 'source_chunk_index': [0, 1, 2]}, 'Input resolution': {'description': ['The size of the input images, which significantly impacts detection accuracy.'], 'type': ['generic', 'GENERIC'], 'source_chunk_index': [0, 1, 2]}, 'conv5_3': {'description': ['A specific convolutional layer within the VGG16 architecture, used as input to the RPN and classification network.', 'A specific convolutional layer within the VGG16 architecture, used as a feature extractor.', 'A specific convolutional layer (the 13th layer) within the VGG16 CNN architecture. The paper investigates its impact on car detection accuracy.', 'The 5th convolutional layer of AlexNet, used as input to the R-CNN region-proposal and classification branches.'], 'type': ['GENERIC', 'method', 'generic'], 'source_chunk_index': [1, 2]}, 'Conv5_3': {'description': ['A convolutional layer within the VGG16 CNN architecture, used as a feature extractor in Faster R-CNN. The activations from this layer serve as input to both the region proposal network (RPN) and the classification network.', 'The 5th convolutional layer of AlexNet, used as input to the R-CNN region-proposal and classification branches.'], 'type': ['METHOD', 'method'], 'source_chunk_index': [1, 2]}, 'Conv4_3': {'description': ['A convolutional layer within the VGG16 CNN architecture. The paper examines the use of features from convolutional layers that are the bottom layers of the previous pooling layer, such as conv4_3.', 'A specific convolutional layer within the VGG16 architecture, used as a feature extractor.', 'A specific convolutional layer (the 10th layer) within the VGG16 CNN architecture. The paper investigates its impact on car detection accuracy.'], 'type': ['METHOD', 'generic'], 'source_chunk_index': [1, 2]}, 'Context Window': {'description': ['An additional feature extraction branch added to improve accuracy.', 'An additional feature extraction branch added to the R-CNN framework to improve accuracy. It extracts features from a surrounding region (context) around the potential objects.'], 'type': ['generic', 'method'], 'source_chunk_index': [2]}}
