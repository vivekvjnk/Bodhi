ion': {'type': ['task', 'task'], 'description': ['The primary objective of the study, which involves identifying and locating cars within images using the Faster R-CNN architecture.', 'The task of identifying and locating cars within images, a primary focus of the study.'], 'source_chunk_index': [1, 2]}, 'Fully Connected Layers': {'type': ['GENERIC'], 'description': ['Layers used in VGG16 and AlexNet as the R-CNN branch in the Faster R-CNN architecture.'], 'source_chunk_index': [1]}, 'R-CNN Branch': {'type': ['GENERIC'], 'description': ['The component of the Faster R-CNN architecture that uses fully connected layers for classification and bounding box regression.'], 'source_chunk_index': [1]}, 'IoU': {'type': ['generic'], 'description': ["Intersection over Union, a metric used in the KITTI dataset's evaluation criteria to assess the overlap between proposal boxes and ground truth boxes. Proposal boxes having an IoU greater than 70% are counted as true detections for cars."], 'source_chunk_index': [1]}, 'Context Window': {'type': ['GENERIC'], 'description': ['An additional component used to improve the accuracy of car detection by incorporating features extracted from a surrounding region.'], 'source_chunk_index': [2]}, 'Inference Time': {'type': ['GENERIC'], 'description': ['The time taken by a model to make a prediction, measured in seconds, for different configurations and methods.'], 'source_chunk_index': [2]}, 'conv5 layer': {'type': ['generic'], 'description': ['A specific convolutional layer within the AlexNet architecture.'], 'source_chunk_index': [2]}, 'conv4_3 layer': {'type': ['generic'], 'description': ['A specific convolutional layer within the VGG16 architecture.'], 'source_chunk_index': [2]}, '3DOP': {'type': ['method'], 'description': ['A method used for car detection, compared with Faster R-CNN.'], 'source_chunk_index': [2]}, 'Pre-training': {'type': ['generic'], 'description': ['The process of training a model on a large dataset (e.g., ImageNet, PAS