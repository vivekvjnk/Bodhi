ategies to Prevent Catastrophic Forgetting': {'type': ['method'], 'description': ['Techniques used during the training of neural networks, like FinBERT, to mitigate the problem of catastrophic forgetting, where the model loses previously learned information when trained on new data.'], 'source_chunk_index': [0]}, 'CNN': {'type': ['method'], 'description': ['A Convolutional Neural Network architecture used for sentiment analysis on the StockTwits dataset.'], 'source_chunk_index': [0]}, 'doc2vec': {'type': ['method'], 'description': ['A method used to generate sentence embeddings for predicting stock market outcomes.'], 'source_chunk_index': [0]}, 'LSTM': {'type': ['method', 'method', 'method'], 'description': ['A type of recurrent neural network that allows long-term dependencies in a sequence to persist in the network by using "forget" and "update" gates. It is used for processing sequential data like text.', 'A type of recurrent neural network used as a baseline method and compared with FinBERT.', 'A Long Short-Term Memory model, a type of recurrent neural network, used as a baseline method for sentiment classification and compared against FinBERT and ULMFit.'], 'source_chunk_index': [1, 4, 4]}, 'GLoVe': {'type': ['method', 'method'], 'description': ['An unsupervised learning algorithm for obtaining vector representations for words. It is used for initializing embeddings in NLP tasks.', 'Global Vectors for Word Representation, a method for obtaining word embeddings.'], 'source_chunk_index': [1, 2]}, 'Text simplification': {'type': ['method'], 'description': ['A technique used to classify sentences from financial news by simplifying the text.'], 'source_chunk_index': [1]}, 'Bi-attentive classification network': {'type': ['method'], 'description': ['A neural network architecture used in conjunction with ELMo to achieve state-of-the-art performance on text classification tasks like SST-5.'], 'source_chunk_index': [1]}, 'AWD-LSTM': {'type': ['method', 'method', 'method'], 'description': ['The underlying language model used in ULMFit, employing sophisticated dropout tuning strategies for regularization.', 'The underlying language model used in ULMFit, employing sophisticated dropout tuning strategies for regularization.', 'A type of Long Short-Term Memory (LSTM) language model used in the ULMFit classifier. It is pre-trained on a general corpus and then fine-tuned on a specific domain corpus.'], 'source_chunk_index': [2, 2, 3]}, 'Transformer': {'type': ['method', 'method'], 'description': ['An attention-based architecture for modeling sequential information, presented as an alternative to recurrent neural networks. It is used in BERT.', 'An attention-based architecture for modeling sequential information, offering an alternative to recurrent neural networks. It has advantages over RNN-based approaches, including better parallelization on GPUs.'], 'source_chunk_index': [2, 2]}, 'BERT': {'type': ['method'], 'description': ['A language model consisting of a set of Transformer encoders stacked on top of each other. It defines the language modeling task differently from ELMo and AWD-LSTM. FinBERT is based on BERT.'], 'source_chunk_index': [2]}, 'ULMFit': {'type': ['method', 'method', 'method'], 'description': ['A transfer learning model for down-stream NLP tasks that utilizes language model pre-training. It fine-tunes the entire language model, including task-specific layers.', 'A transfer learning method used as a baseline and compared with FinBERT.', 'Universal Language Model Fine-tuning, a transfer learning method used as a baseline for sentiment classification and compared against FinBERT.'], 'source_chunk_index': [2, 4, 4]}, 'BERT-base': {'type': ['method'], 'description': ['A version of BERT with 12 encoder layers, a hidden size of 768, 12 multi-head attention heads, and 110M parameters.'], 'source_chunk_index': [3]}, 'BERT-large': {'type': ['method'], 'description': ['A version of BERT with 24 encoder layers, a hidden size of 1024, 16 multi-head attention heads, and 340M parameters.'], 'source_chunk_index': [3]}, 'BookCorpus': {'type': ['dataset'], 'description': ['A dataset used to train BERT, containing a large collection of books.'], 'source_chunk_index': [3]}, 'English Wikipedia': {'type': ['dataset'], 'description': ['A dataset used to train BERT, comprising the content of the English Wikipedia.'], 'source_chunk_index': [3]}, 'LSTM classifier with GLoVe embeddings': {'type': ['method'], 'description': ['A baseline method for sentiment classification, using Long Short-Term Memory (LSTM) with Global Vectors for Word Representation (GloVe) embeddings.'], 'source_chunk_index': [3]}, 'LSTM classifier with ELMo embeddings': {'type': ['method'], 'description': ['A baseline method for sentiment classification, using Long Short-Term Memory (LSTM) with Embeddings from Language Models (ELMo) embeddings.'], 'source_chunk_index': [3]}, 'ULMFit classifier': {'type': ['method'], 'description': ['A baseline method for sentiment classification, using Universal Language Model Fine-tuning (ULMFit).'], 'source_chunk_index': [3]}, 'TRC 2-financial corpus': {'type': ['dataset'], 'description': ['A financial corpus used for pre-training the AWD-LSTM language model in the ULMFit classifier.'], 'source_chunk_index': [3]}, 'Vanilla BERT': {'type': ['method'], 'description': ['A BERT model without further pre-training, used as a baseline for comparison.'], 'source_chunk_index': [4]}, 'FinBERT-task': {'type': ['method'], 'description': ['A FinBERT model further pre-trained on the classification training set.'], 'source_chunk_index': [4]}, 'FinBERT-domain': {'type': ['method'], 'description': ['A FinBERT model further pre-trained on a domain-specific corpus, TRC 2-financial.'], 'source_chunk_index': [4]}, 'Reuters TRC-2 corpus': {'type': ['dataset'], 'description': ['A dataset used in the study, shared by NIST.'], 'source_chunk_index': [5]}, 'No adjustment (NA)': {'type': ['method'], 'description': ['A setting used in the study to measure the performance of techniques against catastrophic forgetting.'], 'source_chunk_index': [5]}, 'Slanted triangular learning rate (STL)': {'type': ['method'], 'description': ['A technique used in the study to optimize training and prevent catastrophic forgetting.'], 'source_chunk_index': [5]}, 'Slanted triangular learning rate and gradual unfreezing (STL+GU)': {'type': ['method'], 'description': ['A setting used in the study to measure the performance of techniques against catastrophic forgetting, combining slanted triangular learning rate and gradual unfreezing.'], 'source_chunk_index': [5]}, 'sentiment analysis': {'description': ["The task of determining the emotional tone or attitude expressed in a piece of text, central to the FinBERT model's application in financial NLP."], 'type': ['task'], 'source_chunk_index': [0, 1, 2, 3, 4, 5]}, 'transfer learning': {'description': ['A machine learning technique used to leverage knowledge gained from one task to improve performance on a related task, applied in the development of FinBERT.', 'A machine learning technique used to apply knowledge gained from one task to another, employed in FinBERT to adapt pre-trained models for financial text analysis.'], 'type': ['method'], 'source_chunk_index': [0, 1, 2, 3, 4, 5]}, 'discriminative fine-tuning': {'description': ['A technique used to optimize the training of FinBERT, allowing different layers of the model to learn at different rates.', 'A technique used to optimize the training of FinBERT, allowing different layers of the model to learn at different rates.', 'A technique used to optimize the training of FinBERT, allowing different layers of the model to learn at different rates.', 'A technique used in the study to optimize training and prevent catastrophic forgetting.'], 'type': ['method'], 'source_chunk_index': [0, 3, 4, 5]}, 'slanted triangular learning rates': {'description': ['A learning rate schedule used to optimize the training of FinBERT, helping to improve performance.', 'A learning rate schedule used in ULMFit that starts with a small learning rate, increases it linearly to a maximum value, and then decreases it linearly.'], 'type': ['method'], 'source_chunk_index': [0, 1, 3, 4, 5]}, 'gradual unfreezing': {'description': ['A technique used to optimize the training of FinBERT, preventing catastrophic forgetting by unfreezing layers of the model gradually.', 'A technique used in ULMFit where layers of a pre-trained model are unfrozen sequentially during fine-tuning, starting with the last layer and proceeding to earlier layers.'], 'type': ['method'], 'source_chunk_index': [0, 1, 3, 4, 5]}, 'Discriminative Fine-tuning': {'description': ['A technique used in ULMFit to fine-tune a pre-trained language model, allowing different layers of the model to be fine-tuned at different learning rates.', 'A technique used to optimize the training of FinBERT, allowing different layers of the model to learn at different rates.', 'A technique used in the study to optimize training and prevent catastrophic forgetting.'], 'type': ['method'], 'source_chunk_index': [1, 5]}}
