_chunk_index': [1]}, 'Filter Sizes': {'type': ['method'], 'description': ['The size of the convolutional filters used in CNNs. Some sparse convolution methods are limited to large filter sizes, restricting their applicability to modern CNNs that often use small filters.'], 'source_chunk_index': [1]}, 'Sparse Convolution': {'type': ['method', 'method', 'method'], 'description': ['A method to reduce compute requirements and improve classification speed by applying sparsity to convolution layers.', 'A method used to reduce the computational requirements and improve classification speed in CNNs by applying sparsity to the convolution layers.', 'A method that leverages sparsity in convolutional layers to reduce computation and accelerate CNNs.'], 'source_chunk_index': [1, 1, 2]}, 'Xeon processors': {'type': ['method'], 'description': ["The processor on which the direct sparse convolution algorithm's performance was evaluated, achieving a 3.4x speedup over the best dense direct convolution performance in AlexNet."], 'source_chunk_index': [1]}, 'Atom processors': {'type': ['method'], 'description': ["The processor on which the direct sparse convolution algorithm's performance was evaluated, achieving a 7.3x speedup over the best dense direct convolution performance in AlexNet."], 'source_chunk_index': [1]}, 'AlexNet classification throughput': {'type': ['task'], 'description': ['The task of classifying images using the AlexNet CNN model, with a throughput of 2,371 images per second on one platform and 120 images per second on another, as a result of the direct sparse convolution algorithm.'], 'source_chunk_index': [1]}, 'AlexNet': {'type': ['method', 'method'], 'description': ['A convolutional neural network architecture used as a case study to demonstrate the performance of sparse CNNs.', 'The CNN architecture used to demonstrate 3.4x and 7.3x speedups of convolution layers over the best dense convolution on representative server and mobile platforms.'], 'source_chunk_index': [1, 3]}, 'Small Kernel Size': {'type': ['task'], 'description': ['The objective of applying sparse convolution methods to CNNs with small filter sizes (e.g., 3x3), which are common in modern CNNs.'], 'source_chunk_index': [1]}, 'Pruning': {'type': ['method'], 'description': ['A method to reduce model size by removing connections or weights, applied to fully connected and convolutional layers.'], 'source_chunk_index': [2]}, 'Dense convolution': {'type': ['method'], 'description': ['The standard convolution operation, used as a baseline for comparison with sparse convolution.'], 'source_chunk_index': [2]}, 'FLOP/s': {'type': ['method'], 'description': ['Floating point operations per second, a metric used to measure the computational performance of a system, particularly relevant in the context of sparse convolution and its speedup over dense convolution.'], 'source_chunk_index': [2]}, 'Speeding up CNNs': {'type': ['task'], 'description': ['The objective of the direct sparse convolution algorithm, aiming to improve the computational efficiency of CNNs.'], 'source_chunk_index': [2]}, 'SpMV': {'type': ['method'], 'description': ['Sparse Matrix-Vector multiplication, a computational kernel used in the context of sparse convolution, particularly relevant for memory bandwidth considerations.'], 'source_chunk_index': [2]}, 'BDW': {'type': ['task'], 'description': ['The platform on which the Holistic SparseCNN achieves a classification speed of 2,371 images per second.'], 'source_chunk_index': [3]}, 'Weight decay 1e-5': {'type': ['method'], 'description': ['A specific weight decay regularization parameter used for fully connected (FC) layers.'], 'source_chunk_index': [3]}, 'Weight decay 5e-5': {'type': ['method'], 'description': ['A specific weight decay regularization parameter used for fully connected (FC) layers.'], 'source_chunk_index': [3]}, 'Weight decay 6e-5': {'type': ['method'], 'description': ['A specific weight decay regularization parameter used for fully connected (FC) layers.'], 'source_chunk_index': [3]}, 'SGEMM': {'type': ['method'], 'description': ['Highly optimized general matrix multiplication (GEMM) implementation, used as a proxy for dense convolution performance to quantify layer-wise speedups of Holistic SparseCNN.'], 'source_chunk_index': [3]}, 'Fully connected layers': {'description': ['Layers in a neural network that are pruned to affect model size.', 'Layers in a CNN that are pruned to affect model size.', 'Layers in a neural network that are pruned to affect model size.', 'Layers within a CNN that are fully connected, primarily affecting model size. The text discusses the synergies between sparse convolution and sparse methods on these layers.'], 'type': ['method'], 'source_chunk_index': [0, 1, 2, 3]}, 'Convolution layers': {'description': ['Layers in a neural network that are pruned to impact computation and speed.', 'Layers in a CNN that are pruned to impact computation and speed.', 'Layers in a neural network that are pruned to impact computation and speed.', 'Layers within a CNN that perform convolution operations, which are significantly impacted by sparsity and directly affect computation and speed. The text discusses the impact of sparsity on these layers.'], 'type': ['method'], 'source_chunk_index': [0, 1, 2, 3]}, 'Direct sparse convolution algorithm': {'description': ['An algorithm discussed in the paper for performing sparse convolution.', 'An algorithm discussed in the paper for performing sparse convolution.', 'A specific algorithm discussed in the paper for performing sparse convolution.', 'An algorithm discussed in the paper for performing sparse convolution.'], 'type': ['method'], 'source_chunk_index': [0, 1, 2, 3]}}
