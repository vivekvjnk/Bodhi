x': [3]}, 'Weight decay': {'type': ['method'], 'description': ['The regularization technique used to control the magnitude of the weights in the neural network, with specific values (1e-5, 5e-5, and 6e-5) applied to different layers.'], 'source_chunk_index': [3]}, 'SGEMM': {'type': ['method'], 'description': ['A highly optimized Basic Linear Algebra Subprograms (BLAS) routine used as a proxy to quantify the performance of dense convolution layers.'], 'source_chunk_index': [3]}, 'Arithmetic Intensity': {'description': ['A factor that influences the efficiency of sparse convolution, where lower arithmetic intensity can lead to increased data transfer overhead.', 'A factor considered in the analysis of trade-offs between sparsity levels, speedups, and accuracy.'], 'type': ['method'], 'source_chunk_index': [1, 2]}}
