': ['method'], 'source_chunk_index': [0, 1, 2, 3, 5]}, 'Knowledge distillation (KD)': {'description': ['A technique used to transfer knowledge from a larger, more complex model (teacher) to a smaller, more efficient model (student).', 'A method used to transfer knowledge from a larger teacher model (BERT) to a smaller student model (TinyBERT).'], 'type': ['method'], 'source_chunk_index': [0, 1, 2, 5]}, 'Weights pruning': {'description': ['A technique used to reduce the size of a model by removing less important weights.', 'A technique used for model compression by removing less important weights in a neural network.', 'A model compression technique that reduces the size of a neural network by removing less important weights.'], 'type': ['method'], 'source_chunk_index': [0]}, 'Multi-hop Reasoning Task': {'description': ['A complex natural language processing task that requires reasoning across multiple pieces of information or steps.', 'The citation for the multi-hop reasoning task paper.'], 'type': ['task', 'generic'], 'source_chunk_index': [0]}, 'knowledge distillation (KD) (Romero et al., 2014)': {'description': ['The citation for the knowledge distillation paper.', 'A method to transfer knowledge from a larger, more complex model (teacher) to a smaller, more efficient model (student).', 'A method used to transfer knowledge from a larger teacher model (BERT) to a smaller student model (TinyBERT).'], 'type': ['method', 'generic'], 'source_chunk_index': [0, 1, 2]}, 'Attention matrices': {'description': ['Representations derived from the Transformer layer, used in the distillation process.', 'A matrix within the Transformer model that captures linguistic knowledge.'], 'type': ['generic'], 'source_chunk_index': [1, 2]}, 'Data augmentation': {'description': ['A technique used to provide more task-related materials for teacher-student learning during the task-specific distillation stage.', 'A method used to extend the task-specific training set, involving word-level replacement using BERT and GloVe embeddings.', 'A method explained in the text.', 'A key procedure in the two-stage TinyBERT learning framework.'], 'type': ['method'], 'source_chunk_index': [1, 3, 4, 5]}, 'Task-specific knowledge': {'description': ['Knowledge relevant to a specific task.', 'The specific type of knowledge being transferred during the distillation process, which is tailored to the particular task being performed.'], 'type': ['generic'], 'source_chunk_index': [1, 7]}, 'Prediction-layer distillation': {'description': ["A specific technique used in the Transformer distillation process, focusing on transferring knowledge from the teacher model's prediction layer to the student model.", 'A distillation process performed during the training of TinyBERT, where knowledge is transferred between the prediction layers of the teacher and student models.', 'A specific knowledge distillation technique applied to the prediction layer.'], 'type': ['method'], 'source_chunk_index': [2, 3, 5, 6]}, 'Task-specific distillation': {'description': ['A distillation approach that fine-tunes TinyBERT on augmented task-specific datasets to improve performance on specific NLP tasks.', 'A component of TinyBERT learning.', 'A distillation method focused on transferring task-specific knowledge.'], 'type': ['method'], 'source_chunk_index': [3, 4, 5, 7]}, 'General distillation': {'description': ['A distillation approach that helps TinyBERT learn from teacher BERT to improve generalization capability.', 'A component of TinyBERT learning.', 'The objective of transferring knowledge from the teacher BERT to the student TinyBERT at the pre-training stage, as proposed to make TinyBERT effectively work for all tasks.'], 'type': ['task', 'method'], 'source_chunk_index': [3, 5, 7]}, 'Intermediate layer distillation': {'description': ['A distillation process performed during the training of TinyBERT, where knowledge is transferred between intermediate layers of the teacher and student models.', 'A knowledge distillation technique applied to intermediate layers of the model.'], 'type': ['method'], 'source_chunk_index': [3, 6]}, 'General Distillation (GD)': {'description': ['A key procedure in the two-stage TinyBERT learning framework.', 'A distillation method used for initializing TinyBERT.', 'The objective of transferring knowledge from the teacher BERT to the student TinyBERT at the pre-training stage, as proposed to make TinyBERT effectively work for all tasks.'], 'type': ['task', 'method'], 'source_chunk_index': [4, 7]}, 'Transformer-based distillation': {'description': ['A new knowledge distillation method introduced for Transformer-based models.', 'A specific knowledge distillation technique applied to the Transformer layers.'], 'type': ['method'], 'source_chunk_index': [5]}}
