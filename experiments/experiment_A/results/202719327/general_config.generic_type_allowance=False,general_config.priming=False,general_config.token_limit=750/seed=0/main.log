_index': [3, 4]}, 'MRPC': {'type': ['task', 'dataset', 'dataset'], 'description': ['A paraphrase identification task used to evaluate the performance of TinyBERT.', 'A dataset used for evaluating natural language understanding models.', 'The Microsoft Research Paraphrase Corpus, a dataset used for paraphrase identification.'], 'source_chunk_index': [3, 4, 4]}, 'CoLA': {'type': ['task', 'dataset', 'dataset'], 'description': ['A linguistic acceptability judgment task used to evaluate the performance of TinyBERT.', 'A dataset used for evaluating natural language understanding models.', 'The Corpus of Linguistic Acceptability, a dataset used for evaluating the grammatical acceptability of sentences.'], 'source_chunk_index': [3, 4, 4]}, 'QQP': {'type': ['task'], 'description': ['A question-pair similarity task used to evaluate the performance of TinyBERT.'], 'source_chunk_index': [3]}, 'QNLI': {'type': ['task'], 'description': ['A question-answering task used to evaluate the performance of TinyBERT.'], 'source_chunk_index': [3]}, 'Intermediate Layer Distillation': {'type': ['method'], 'description': ['A knowledge distillation method where the intermediate layers of the student model are trained to mimic the outputs of the corresponding layers in the teacher model.'], 'source_chunk_index': [3]}, 'KD method for Transformer-based distillation': {'type': ['method'], 'description': ['The specific knowledge distillation method used for Transformer-based distillation, which is the core contribution of the paper.'], 'source_chunk_index': [3]}, 'Edge devices': {'type': ['task'], 'description': ['The target application environment for TinyBERT, highlighting its suitability for resource-constrained devices.'], 'source_chunk_index': [3]}, 'Learning Rate': {'type': ['method'], 'description': ['The learning rate used during the task-specific distillation phase, specifically 5e-5 for intermediate layer distillation and 3e-5 for prediction layer distillation.'], 'source_chunk_index': [3]}, 'Batch Size': {'type': ['method'], 'description': ['The batch size used during the task-specific distillation phase, specifically 32 for intermediate layer distillation and prediction layer distillation, except for MNLI, QQP, and QNLI where it is 256.'], 'source_chunk_index': [3]}, 'SQuAD v1.1': {'type': ['dataset'], 'description': ['A question answering dataset used to evaluate the performance of models.'], 'source_chunk_index': [4]}, 'SQuAD v2.0': {'type': ['dataset'], 'description': ['An updated version of the SQuAD dataset, used for question answering tasks.'], 'source_chunk_index': [4]}, 'Question Answering (QA)': {'type': ['task'], 'description': ['A task focused on enabling a model to answer questions based on provided context.'], 'source_chunk_index': [4]}, 'MLM and NSP tasks': {'type': ['task'], 'description': ['Tasks used in pre-training BERT models.'], 'source_chunk_index': [4]}, 'Stanford Sentiment Treebank': {'type': ['dataset'], 'description': ['A binary single-sentence classification task where the goal is to predict the sentiment of movie reviews.'], 'source_chunk_index': [4]}, 'Knowledge distillation (KD)': {'description': ['A technique used to transfer knowledge from a larger, more complex model (teacher) to a smaller, more efficient model (student).'], 'type': ['method'], 'source_chunk_index': [0, 1, 2]}, 'Data augmentation': {'description': ['The process of artificially increasing the amount of data by creating modified versions of existing data.', 'The process of creating more task-related materials for teacher-student learning in the task-specific distillation stage.', 'A procedure within the TinyBERT learning framework, used to augment the dataset.'], 'type': ['method'], 'source_chunk_index': [0, 3]}, 'Prediction-layer distillation': {'description': ['A distillation technique applied to the prediction layer of the Transformer model.', 'A knowledge distillation method where the prediction layer (e.g., the output layer for classification) of